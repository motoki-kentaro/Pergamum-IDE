{
  "name": "pergamum",
  "productName": "Pergamum",
  "version": "0.90.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "author": "Pergamum Contributors",
  "description": "An open-source IDE for novelists.",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "review": "node scripts/review-local.mjs --backend openai --prompt-file scripts/reviewer-prompt-bonsai.md",
    "review:bonsai": "node scripts/review-local.mjs --backend openai --prompt-file scripts/reviewer-prompt-bonsai.md",
    "review:qwen": "node scripts/review-local.mjs --compact",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "npm run typecheck && electron-forge package",
    "build:installer": "npm run typecheck && electron-forge package && electron-builder --win nsis",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "generate:third-party-licenses": "node scripts/generateThirdPartyLicenses.js"
  },
  "build": {
    "afterPack": "scripts/electronBuilderAfterPack.js",
    "extraResources": [
      "LICENSE",
      "THIRD_PARTY_LICENSES.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      ".vite/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/kuromoji/dict/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "fileAssociations": [
        {
          "ext": "pergamum",
          "name": "Pergamum Project",
          "description": "Pergamum Project File",
          "icon": "assets/icons/file-associations/pergamum/pergamum-scroll-file-icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "build/installer.nsh",
      "artifactName": "${productName}.Setup.${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@textlint/kernel": "^15.8.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@textlint/textlint-plugin-text": "^15.8.0",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "encoding-japanese": "^2.4.0",
    "highlight.js": "^11.12.0",
    "iconv-lite": "^0.7.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdownlint": "^0.41.1",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "textlint": "^15.8.0",
    "textlint-rule-preset-japanese": "^10.0.4",
    "uisfx": "^0.4.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
