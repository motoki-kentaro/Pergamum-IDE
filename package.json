{
  "name": "pergamum",
  "productName": "Pergamum",
  "version": "0.80.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "author": "Pergamum Contributors",
  "description": "An open-source IDE for novelists.",
  "main": ".vite/build/main.js",
  "scripts": {
    "review": "node scripts/review-local.mjs --backend openai --prompt-file scripts/reviewer-prompt-bonsai.md",
    "review:bonsai": "node scripts/review-local.mjs --backend openai --prompt-file scripts/reviewer-prompt-bonsai.md",
    "review:qwen": "node scripts/review-local.mjs --compact",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "build": "npm run typecheck && electron-forge package",
    "build:installer": "npm run typecheck && electron-forge package && electron-builder --win nsis",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      ".vite/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "fileAssociations": [
        {
          "ext": "pergamum",
          "name": "Pergamum Project",
          "description": "Pergamum Project File",
          "icon": "assets/icons/file-associations/pergamum/pergamum-scroll-file-icon.ico"
        }
      ]
    },
    "nsis": {
      "perMachine": true
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@textlint/kernel": "^15.8.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@textlint/textlint-plugin-text": "^15.8.0",
    "better-sqlite3": "^13.0.3",
    "codemirror": "^6.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "encoding-japanese": "^2.4.0",
    "highlight.js": "^11.12.0",
    "iconv-lite": "^0.7.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.0",
    "markdownlint": "^0.41.1",
    "mermaid": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "textlint": "^15.8.0",
    "textlint-rule-preset-japanese": "^10.0.4",
    "uisfx": "^0.4.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "katex": "$katex"
  }
}
