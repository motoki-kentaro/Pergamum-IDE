    "commandId": "workspace.glossary.toggle",
    "executionHost": "renderer",
    "handlerStatus": "callbackDirect",
    "keys": [
      "Mod-Shift-g",
    ],
    "readonly": false,
    "scope": "pane",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "category": "View",
    "commandId": "editor.preview.toggle",
    "executionHost": "renderer",
    "handlerStatus": "registered",
    "keys": [
      "Mod-Shift-p",
    ],
    "readonly": false,
    "scope": "editor",
    "source": "pergamum",
    "when": "activeMarkdownDocument",
  },
  {
    "category": "View",
    "commandId": "app.zoom.in",
    "executionHost": "renderer",
    "handlerStatus": "registered",
    "keys": [
      "Mod-=",
      "Mod-+",
    ],
    "readonly": false,
    "scope": "app",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "category": "View",
    "commandId": "app.zoom.out",
    "executionHost": "renderer",
    "handlerStatus": "registered",
    "keys": [
      "Mod--",
    ],
    "readonly": false,
    "scope": "app",
    "source": "pergamum",
    "when": "workbenchFocus && !modalOpen",
  },
  {
    "category": "Window",
    "commandId": "window.close",
    "executionHost": "nativeRole",
    "handlerStatus": "nativeRole",
    "keys": [
      "Alt-F4",
    ],
    "readonly": true,
    "scope": "native",
    "source": "nativeRole",
    "when": "native",
  },
  {
    "category": "Window",
    "commandId": "window.minimize",
    "executionHost": "nativeRole",
    "handlerStatus": "nativeRole",
    "keys": [],
    "readonly": true,
    "scope": "native",
    "source": "nativeRole",
    "when": "native",
  },
  {
    "category": "Window",
    "commandId": "window.toggleFullscreen",
    "executionHost": "nativeRole",
    "handlerStatus": "nativeRole",
    "keys": [
      "F11",
    ],
    "readonly": true,
    "scope": "native",
    "source": "nativeRole",
    "when": "native",
  },
]
`;
